# ===== Turkish Legal RAG System - Environment Variables =====
# Copy this file to `.env` and fill in your values.

# Required only if you use OpenAI embeddings (EMBEDDING_BACKEND=openai)
OPENAI_API_KEY=

# Optional: Hugging Face token for gated/private datasets or to raise rate limits
HF_TOKEN=

# Optional overrides (defaults live in src/config.py)
# EMBEDDING_BACKEND=sentence-transformers
# API_HOST=0.0.0.0
# API_PORT=8000
